{
  "name": "dom-native-pptx",
  "version": "0.2.0-beta.2",
  "description": "Fail-closed HTML DOM to native editable PowerPoint converter and Agent Skill.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dom-native-pptx": "./dist/cli.js"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "ARCHITECTURE.md",
    "RASTER_POLICY.md",
    "SECURITY.md",
    "SOURCE_MAP.md",
    "SUPPORTED_CSS.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UtenKekkoDev/dom-native-pptx.git"
  },
  "bugs": {
    "url": "https://github.com/UtenKekkoDev/dom-native-pptx/issues"
  },
  "homepage": "https://github.com/UtenKekkoDev/dom-native-pptx#readme",
  "keywords": [
    "powerpoint",
    "pptx",
    "html-to-pptx",
    "editable-slides",
    "agent-skill"
  ],
  "author": "Yuxuan Sun",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests scripts",
    "format": "prettier --write src tests scripts .github *.md *.json *.ts *.js",
    "format:check": "prettier --check src tests scripts .github *.md *.json *.ts *.js",
    "test": "vitest",
    "test:run": "vitest run --pool=forks --maxWorkers=1 --bail=1",
    "test:coverage": "vitest run --coverage --pool=forks --maxWorkers=1 --bail=1",
    "test:package": "npm run build && node scripts/verify-package.mjs",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "test:stress": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-stress-suite.ps1",
    "pptx:export": "tsx src/cli.ts export",
    "pptx:validate": "tsx src/cli.ts validate",
    "pptx:inspect": "tsx src/cli.ts inspect",
    "pptx:render-html": "tsx src/cli.ts render-html",
    "pptx:render-powerpoint": "powershell -NoProfile -ExecutionPolicy Bypass -File src/validate/powerpoint-validator.ps1",
    "pptx:compare": "tsx src/cli.ts compare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.7.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.5",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.13",
    "commander": "^15.0.0",
    "jszip": "^3.10.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "pptxgenjs": "^4.0.1",
    "saxes": "6.0.0",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  }
}
